# Backend image. Build context = repository root (needs both backend/ and data/).
#   docker build -f deploy/Dockerfile.backend -t product-agent-backend .
FROM node:22-alpine

ENV NODE_ENV=production
WORKDIR /app

# Install dependencies first (cached layer: only re-runs when package files change)
COPY backend/package.json backend/package-lock.json ./backend/
RUN cd backend && npm ci --omit=dev && npm cache clean --force

# App code + catalog data. Paths in src/configs/paths.js resolve to /app/backend and /app/data.
COPY backend/src ./backend/src
COPY backend/scripts ./backend/scripts
COPY data/bosch_product_catalog_mock.csv ./data/

# Run as the non-root "node" user; it must own the logs folder
RUN mkdir -p /app/backend/logs && chown -R node:node /app
USER node

WORKDIR /app/backend
EXPOSE 3001

# Docker marks the container unhealthy if /api/health stops answering
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3001/api/health > /dev/null || exit 1

# Secrets come from the env file passed at runtime (docker compose env_file), never baked into the image
CMD ["node", "src/server.js"]
