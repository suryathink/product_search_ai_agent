OPENAI_API_KEY=sk-...
# Any chat model that supports tool calling. Small/fast models work well because the tools do the heavy lifting.
OPENAI_MODEL=gpt-4.1-mini
PORT=3001
# Browser origins allowed to call the API. * = allow access from everywhere (default).
# To restrict: comma-separated list, e.g. http://localhost:5173,https://www.example.com
CORS_ORIGINS=*

# Vector store: qdrant | local  (default: qdrant if QDRANT_URL is set, else local)
# Override per run with: npm run dev:local / npm run dev:qdrant
VECTOR_STORE=qdrant
# Qdrant Cloud: cloud.qdrant.io -> create free cluster -> copy the cluster URL and an API key
# (local Docker alternative: docker run -p 6333:6333 qdrant/qdrant  ->  QDRANT_URL=http://localhost:6333, no key)
QDRANT_URL=https://xxxxxxxx-xxxx.eu-central-1-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=bosch_products

# MongoDB (Atlas) — conversations, interactions and feedback are persisted here in addition to log files.
# Leave empty to disable (log files only). Writes are non-blocking; if Mongo is down the chat still works.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGO_DB=bosch_product_agent
# Auto-delete conversation data after N days (TTL index)
MONGO_TTL_DAYS=90
# Also write conversation content to logs/interactions.*.log and logs/feedback.*.log?
# true for development; set false in production so user conversations live only in MongoDB.
INTERACTION_FILE_LOGS=true
# --- Guardrails ---
# Per-IP rate limits for chat (express-rate-limit)
RATE_LIMIT_PER_MINUTE=15
RATE_LIMIT_PER_DAY=300
# OpenAI Moderation API (free) on the user's message and on the final answer
MODERATION_ENABLED=true
MODERATION_CHECK_OUTPUT=true
# If the moderation API is down: true = allow (availability first), false = refuse (safety first)
MODERATION_FAIL_OPEN=true
# Max characters per user message (matches the widget input limit)
MAX_USER_CHARS=1000








# info | debug (debug also logs every LLM step and tool call)
LOG_LEVEL=info
# Storage limit for the whole logs folder: oldest files are deleted so only the latest N MB are kept
LOG_MAX_TOTAL_MB=30
# A single log file rolls over at this size (default: a tenth of the total)
LOG_MAX_FILE_MB=3
# Token prices (USD per 1M) used for cost estimates in logs/metrics — set to your model's real pricing
PRICE_INPUT_PER_1M=0.4
PRICE_OUTPUT_PER_1M=1.6
